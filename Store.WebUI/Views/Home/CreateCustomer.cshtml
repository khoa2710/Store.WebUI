<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white fw-semibold">
        Quick Example – Customer
    </div>

    <div class="card-body">
        <form method="post">
            <!-- Email -->
            <div class="mb-4">
                <label for="custEmail" class="form-label fw-semibold">Email address</label>
                <input type="email" id="custEmail" name="Email"
                       class="form-control form-control-lg" placeholder="Enter email">
            </div>

            <!-- Password + Confirm -->
            <div class="mb-4">
                <label for="custPwd" class="form-label fw-semibold">Password</label>
                <input type="password" id="custPwd" name="Password"
                       class="form-control form-control-lg" placeholder="Password">
            </div>

            <div class="mb-4">
                <label for="custPwd2" class="form-label fw-semibold">Confirm password</label>
                <input type="password" id="custPwd2" name="ConfirmPassword"
                       class="form-control form-control-lg" placeholder="Re-enter password">
            </div>

            <!-- Address -->
            <div class="mb-4">
                <label for="custAddress" class="form-label fw-semibold">Address</label>
                <input type="text" id="custAddress" name="Address"
                       class="form-control form-control-lg" placeholder="123 Main St, City">
            </div>

            <!-- Phone -->
            <div class="mb-4">
                <label for="custPhone" class="form-label fw-semibold">Phone</label>
                <input type="tel" id="custPhone" name="Phone"
                       class="form-control form-control-lg" placeholder="+1 555-123-4567">
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
        </form>
    </div>
</div>
