<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Store.WebUI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Store.WebUI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    @* ===== NEW: StartBootstrap CSS (real file) ===== *@
    <link rel="stylesheet" href="~/assetSample/css/styles.css" asp-append-version="true" />
    @* ===== OPTIONAL: your own tweaks (delete if unused) ===== *@
    <link rel="stylesheet" href="~/css/custom-header.css" asp-append-version="true" />
    @* =============================================== *@

    @RenderSection("Styles", required: false)
</head>
<body>

    @* ===== Top hotline/email bar (as you wanted) ===== *@
    <div class="top-hotline-bar text-white py-1" style="background:#004aad;">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2 small">
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-telephone"></i> Hotline: 0799 599 666</span>
                <span><i class="bi bi-envelope"></i> sales@thegioiapp.vn</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-warning fw-semibold px-3" asp-controller="Account" asp-action="Register">Đăng ký</a>
                <a class="btn btn-sm btn-primary fw-semibold px-3" asp-controller="Account" asp-action="Login" style="background:#0d4aa2;border-color:#0d4aa2;">Đăng nhập</a>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    THEGIOI<span class="text-warning">APP</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="mainNav">
                    <ul class="navbar-nav mb-2 mb-lg-0">

                        @* ===== NEW: Dropdown Sản phẩm ===== *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navProducts" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Sản phẩm
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navProducts">
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="thue-zoom">Thuê Zoom</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="capcut-pro">Capcut Pro</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="zalo-business">Zalo Business</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="webex-meeting">Webex Meeting</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="tai-khoan-zoom">Tài Khoản Zoom</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="chatgpt-plus">ChatGPT Plus</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="netflix">Netflix</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="spotify">Spotify</a></li>
                                <li><a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-category="youtube-premium">Youtube Premium</a></li>
                            </ul>
                        </li>

                        @* ===== NEW: Dropdown Bảng Giá ===== *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navPricing" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Bảng Giá
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navPricing">
                                <li><a class="dropdown-item" asp-controller="Pricing" asp-action="Zoom">Bảng giá Zoom</a></li>
                                <li><a class="dropdown-item" asp-controller="Pricing" asp-action="Webex">Bảng giá Webex Meeting</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">Tin tức</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>
                    </ul>

                    @* ===== Search + Cart (same) ===== *@
                    <div class="d-flex align-items-center gap-2">
                        <form class="d-flex" asp-controller="Products" asp-action="Index" method="get">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                                <input type="text" name="q" class="form-control border-start-0" placeholder="Tìm kiếm ..." />
                            </div>
                        </form>
                        <a class="btn btn-primary btn-sm" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3"></i> Giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @*
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Store.WebUI - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* ===== NEW: StartBootstrap JS (real file) ===== *@
    <script src="~/assetSample/js/scripts.js" asp-append-version="true"></script>
    @* ============================================= *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
