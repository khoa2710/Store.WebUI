    @model Store.WebUI.Models.ViewModel.HomeViewModel.HomeProductsViewModel

<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<h1 class="mb-3 text-center">Products</h1>
<a asp-action="AddProduct" class="btn btn-success mb-3">Add New Product</a>
<div>
    <!-- Filter card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Product Filters</span>
            <button class="btn btn-sm btn-link text-decoration-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#productFilter"
                    aria-expanded="true"
                    aria-controls="productFilter">
                <i class="bi bi-sliders"></i> Toggle
            </button>
        </div>

        <div id="productFilter" class="collapse">
            <div class="card-body">
                @using (Html.BeginForm(FormMethod.Get, new { @class = "row g-3" }))
                {
                    <div class="col-md-3">@Html.TextBox("productName", Model?.ProductName, new { @class = "form-control", placeholder = "Product Name" })</div>
                    <div class="col-md-3">@Html.TextBox("categoryName", Model?.CategoryName, new { @class = "form-control", placeholder = "Category Name" })</div>
                    <div class="col-md-2">@Html.TextBox("priceFrom", Model?.PriceFrom, new { @class = "form-control", type = "number", placeholder = "Min $" })</div>
                    <div class="col-md-2">@Html.TextBox("priceTo", Model?.PriceTo, new { @class = "form-control", type = "number", placeholder = "Max $" })</div>
                    <div class="col-md-2">@Html.TextBox("createFrom", Model?.CreateFrom?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-2">@Html.TextBox("createTo", Model?.CreateTo?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Find</button></div>
                }
            </div>
        </div>
    </div>


</div>


    
<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>

            <th>Id</th>
            <th>Name</th>
            <th>Badge</th>
            <th>Category Id</th>
            <th>Category Name</th>
            <th>Description</th>
            <th>DiscountAmount</th>
            <th>Image URL</th>
            <th>IsActive</th>
            <th>Price</th>
            <th>StockQuantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Products)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@string.Join(", ", item.Badges!)</td>
                <td>@item.CategoryId</td>
                <td>@item.CategoryName</td> 
                <td>@item.Description</td>
                <td>@item.DiscountAmount</td>
                <td><img src="@item.ImageUrl" style="width: 100px; height: auto" alt="@item.Name" /></td>
                <td>@item.IsActive</td>
                <td>@item.Price</td>
                <td>@item.StockQuantity</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("GetById", new{id = item.Id})" class="btn btn-outline-primary">
                        Detail
                    </a>
                    <a href="@Url.Action("EditById", new{id = item.Id})" class="btn btn-dark">
                        Edit
                    </a>
                    <form action="@Url.Action("DeleteById", new {id = item.Id})" method="post">
                        <button type="submit" class=" btn btn-danger">Delete</button>
                    </form>
                    </div>
                </td>
               
            </tr>
        }
    </tbody>
</table>

@Html.PageLinks(new PagingInfo()
{
    CurrentPage = Model.CurrentPage,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,

},
        5,
        pageIndex => Url.Action("Index", "Products", new { page = pageIndex })
        )