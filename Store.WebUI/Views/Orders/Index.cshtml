@* Views/Orders/Index.cshtml *@
@model Store.WebUI.Models.ViewModel.HomeViewModel.HomeOrdersViewModel
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<h1 class="mb-3 text-center">Orders</h1>

<a asp-action="AddOrder" class="btn btn-success mb-3">Add New Order and Order Details</a>
<div>
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Order Filters</span>
            <button class="btn btn-sm btn-link text-decoration-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#orderFilter"
                    aria-expanded="true"
                    aria-controls="orderFilter">
                <i class="bi bi-sliders"></i> Toggle
            </button>
        </div>

        <div id="orderFilter" class="collapse">
            <div class="card-body">
                @using (Html.BeginForm(FormMethod.Get, new { @class = "row g-3" }))
                {
                    <div class="col-md-3">@Html.TextBox("orderName", Model?.OrderName, new { @class = "form-control", placeholder = "Order Name" })</div>
                    <div class="col-md-2">@Html.TextBox("createFrom", Model?.CreateFrom?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-2">@Html.TextBox("createTo", Model?.CreateTo?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-2">@Html.DropDownList("isActive", new SelectList(new[] { new { Value = "", Text = "Any Active" }, new { Value = "true", Text = "Active" }, new { Value = "false", Text = "Inactive" } }, "Value", "Text", Model?.IsActive?.ToString().ToLower()), new { @class = "form-select" })</div>
                    <div class="col-md-3">@Html.TextBox("status", Model?.Status, new { @class = "form-control", placeholder = "Status" })</div>
                    <div class="col-md-3">@Html.TextBox("productName", Model?.ProductName, new { @class = "form-control", placeholder = "Product Name" })</div>
                    <div class="col-md-2">@Html.TextBox("priceMin", Model?.PriceMin, new { @class = "form-control", type = "number", placeholder = "Min $" })</div>
                    <div class="col-md-2">@Html.TextBox("priceMax", Model?.PriceMax, new { @class = "form-control", type = "number", placeholder = "Max $" })</div>
                    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Find</button></div>
                }
            </div>
        </div>
    </div>



</div>
<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>OrderDate</th>
            <th>OrderAddress</th>
            <th>BillingAddress</th>
            <th>IsActive</th>
            <th>Note</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Orders)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.OrderDate</td>
                <td>@item.OrderAddress</td>
                <td>@item.BillingAddress</td>
                <td>@item.IsActive</td>
                <td>@item.Note</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">
                        
                        <a href="@Url.Action("GetById", new{id = item.Id})" class="btn btn-outline-primary">
                            Detail
                        </a>
                        <a href="@Url.Action("EditById", new{id = item.Id})" class="btn btn-dark">
                            Edit
                        </a>
                        <form action="@Url.Action("DeleteById", new {id = item.Id})" method="post">
                            <button type="submit" class=" btn btn-danger">Delete</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
