@model Store.WebUI.Models.ViewModel.HomeViewModel.HomeCategoriesViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var categorySelectOptions = ViewData["categories"] as List<CategoryDto>;
}


<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<h1 class="mb-3 text-center">Categories</h1>
<a asp-action="AddCategory" class="btn btn-success mb-3">Add New Category</a>
<div>

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Category Filters</span>
            <button class="btn btn-sm btn-link text-decoration-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#categoryFilter"
                    aria-expanded="true"
                    aria-controls="categoryFilter">
                <i class="bi bi-sliders"></i> Toggle
            </button>
        </div>

        <div id="categoryFilter" class="collapse">
            <div class="card-body">
                @using (Html.BeginForm(FormMethod.Get, new { @class = "row g-3" }))
                {
                    <div class="col-md-3">@Html.TextBox("categoryName", Model?.CategoryName, new { @class = "form-control", placeholder = "Category Name" })</div>
                    <div class="col-md-3">@Html.TextBox("slug", Model?.Slug, new { @class = "form-control", placeholder = "Slug" })</div>
                    <div class="col-md-3">@Html.TextBox("createFrom", Model?.CreateFrom?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-3">@Html.TextBox("createTo", Model?.CreateTo?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })</div>
                    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Find</button></div>
                }
            </div>
        </div>
    </div>



</div>


<table class="table table-bordered table-hover">
    <thead class="table-light"> 
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Image URL</th>
            <th>Icon</th>
            <th>Slug</th>
            <th>Actions</th>

        </tr>
    </thead>
    <tbody>
        @* Use Model to access View Model *@
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td><img src=@item.ImageUrl style="width: 100px; height: auto" alt=@item.ImageUrl /></td>
                <td>@item.Icon</td>
                <td>@item.Slug</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("GetById", new{id = item.Id})" class="btn btn-outline-primary">
                        Detail
                    </a>
                    <a href="@Url.Action("EditById", new{id = item.Id})" class="btn btn-dark">
                        Edit
                    </a>
                    <form action="@Url.Action("DeleteById", new {id = item.Id})" method="post">
                        <button type="submit" class=" btn btn-danger">Delete</button>
                    </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
