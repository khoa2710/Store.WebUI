                 </a>
             </li>


             @foreach (var p in Model.PageNumbers)
             {
                 @*asp route là viết lại cái url ở tre*@
                 <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                     <a class="page-link"asp-route-page="@p" asp-route-pageSize="@Model.PageSize">@(p == Model.CurrentPage ? $"{p}" : p.ToString())
                     </a>
                 </li>
             }
             @*boostrap*@
             <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                 <a class="page-link"asp-route-page="@(Model.CurrentPage + 1)"
                     asp-route-pageSize="@Model.PageSize">
                     &gt;
                 </a>
             </li>
         </ul>
     </nav>
 }
-->
@Html.PageLinks(new PagingInfo()
    {
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        TotalPages = Model.TotalPages,
    
    },
    5,
    pageIndex => Url.Action("Index", "Categories", new { page = pageIndex })!
    )