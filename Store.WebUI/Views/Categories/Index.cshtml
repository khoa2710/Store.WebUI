@model Store.WebUI.Models.ViewModel.HomeViewModel.HomeCategoriesViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<h1 class="mb-3 text-center">Categories</h1>
<a asp-action="AddCategory" class="btn btn-success mb-3">Add New Category</a>
<table class="table table-bordered table-hover">
    <thead class="table-light"> 
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Image URL</th>
            <th>Icon</th>
            <th>Slug</th>
            <th>Actions</th>

        </tr>
    </thead>
    <tbody>
        @* Use Model to access View Model *@
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td><img src=@item.ImageUrl style="width: 100px; height: auto" alt=@item.ImageUrl /></td>
                <td>@item.Icon</td>
                <td>@item.Slug</td>
                <td>
                    <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("GetById", new{id = item.Id})" class="btn btn-outline-primary">
                        Detail
                    </a>
                    <a href="@Url.Action("EditById", new{id = item.Id})" class="btn btn-dark">
                        Edit
                    </a>
                    <form action="@Url.Action("DeleteById", new {id = item.Id})" method="post">
                        <button type="submit" class=" btn btn-danger">Delete</button>
                    </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

