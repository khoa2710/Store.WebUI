@model Store.WebUI.Models.ViewModel.GetByIdViewModel.CustomersGetByIdViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<h1>
    Customer Page
</h1>
<table class="table table-bordered">
    @* Display the single Customer *@
    <tr>
        <th>Id</th>
        <td>@Model.Customer?.Id</td>
        </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Customer?.Name</td>
    </tr>
    <tr>
        <th>Email</th>
        <td>@Model.Customer?.Email</td>
    </tr>
    <tr>
        <th>Address</th>
        <td>@Model.Customer?.Address</td>
    </tr>
    <tr>
        <th>Phone</th>
        <td>@Model.Customer?.Phone</td>
    </tr>
</table>
