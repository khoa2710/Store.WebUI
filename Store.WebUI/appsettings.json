{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=.;Database=WebAPI;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAsStrongKeyForJwtTokenGeneration!123",
    "Issuer": "MyApiIssuer",
    "Audience": "MyApiAudience",
    "ExpiryMinutes": 60
  }
}
